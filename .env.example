# ─── burnafter.it v2-mono environment ──────────────────────────────────────────
# Copy to .env, then fill in. Values with $ or quotes: single-quote them
# (docker compose interpolates $VAR inside .env values).

# REQUIRED — app session signing key (>= 32 chars; the app refuses to
# boot on weak/known-default keys)
SECRET_KEY=''

# REQUIRED — Postgres holds ALL state (claims, metadata, blobs)
# ALL-IN-ONE MODE: leave DATABASE_URL UNSET — compose derives it from
# POSTGRES_PASSWORD below. Setting it here with CHANGE_ME would break
# the app container (gate finding #4).
# MULTI-HOST MODE: point it at your central Postgres, e.g.
#   DATABASE_URL='postgres://user:pass@pg.internal:5432/burnafter'
#DATABASE_URL=''

# Postgres password for the postgres service (all-in-one only)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=burnafter
POSTGRES_DB=burnafter

# OPTIONAL — Redis (sessions + rate limiting). Unset = the app boots
# fine with cookie sessions + in-process rate limits.
# ALL-IN-ONE: leave unset (compose derives it). MULTI-HOST: point at
# your central Redis.
#REDIS_URL='redis://redis:6379/0'

# Set to 1 ONLY when running behind a trusted reverse proxy (nginx/
# Apache) — then rate limits key on the real client IP from
# X-Forwarded-For instead of the proxy's IP (gate finding #5).
TRUSTED_PROXY=0

# App bind (gunicorn / container)
HOST=0.0.0.0
PORT=8000

# Rate limiting (create path only; burns are never rate-limited)
RATE_LIMIT=10
RATE_WINDOW=60
